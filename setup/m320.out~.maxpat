                                    "parameter_enable": 0,
                                    "code": "Param master(0.251, min=0, max=1);\nParam panicgain(1, min=0, max=1);\nDelay dl(64);\nDelay dr(64);\nHistory one(1);\nHistory env(0);\nHistory renv(0);\nHistory pg(1);\nsrs = samplerate * one;\nkm = master * one;\nlim = 0.891;\nrel = exp(-1 / (0.1 * srs));\nrrel = exp(-1 / (0.05 * srs));\ninc = 1 / (0.01 * srs);\ntgt = panicgain * one;\npgn = tgt > pg ? min(pg + inc, tgt) : max(pg - inc, tgt);\npg = pgn;\nren = max(abs(in2), renv * rrel);\nrenv = ren;\nright = ren > 0.000001 ? in2 : in1;\nxl = dcblock(in1) * km * pgn;\nxr = dcblock(right) * km * pgn;\npk = max(abs(xl), abs(xr));\nen = max(pk, env * rel);\nenv = en;\ng = min(1, lim / max(en, 0.000001));\ndl.write(xl);\ndr.write(xr);\nout1 = clamp(dl.read(48) * g, -lim, lim);\nout2 = clamp(dr.read(48) * g, -lim, lim);\n",
                                    "fontname": "Arial",
                                    "fontsize": 12.0
                                }
