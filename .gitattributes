# Text files are stored and checked out with LF line endings.
* text=auto eol=lf

# Media and archives are binary: no line-ending changes, no text diffs.
*.wav binary
*.aif binary
*.aiff binary
*.mp3 binary
*.flac binary
*.ogg binary
*.m4a binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.mov binary
*.zip binary

# Repo tooling stays out of downloaded archives.
.github/ export-ignore
.githooks/ export-ignore
